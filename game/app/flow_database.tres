[gd_resource type="Resource" script_class="FlowDatabase" load_steps=10 format=3]

[ext_resource type="Script" path="res://addons/game_flow/data/flow_database.gd" id="1_database"]
[ext_resource type="Script" path="res://addons/game_flow/data/flow_level_entry.gd" id="2_level"]
[ext_resource type="Script" path="res://addons/game_flow/data/flow_cutscene_entry.gd" id="3_cutscene"]
[ext_resource type="Script" path="res://addons/game_flow/data/flow_event.gd" id="4_event"]
[ext_resource type="Script" path="res://addons/game_flow/data/flow_action.gd" id="5_action"]

[sub_resource type="Resource" id="FlowLevelEntry_terrain_test"]
script = ExtResource("2_level")
level_id = &"terrain_test"
scene_path = "res://game/levels/terrain_test.tscn"
display_name = "Terrain Test"
default_spawn = &"default"

[sub_resource type="Resource" id="FlowCutsceneEntry_intro"]
script = ExtResource("3_cutscene")
cutscene_id = &"intro_blank"
scene_path = "res://game/cutscenes/intro_blank.tscn"
display_name = "Introduction"
blocks_input = true
skippable = true

[sub_resource type="Resource" id="FlowAction_entered_save"]
script = ExtResource("5_action")
type = 7
target_id = &"entered_terrain_test"

[sub_resource type="Resource" id="FlowEvent_entered_terrain_test"]
script = ExtResource("4_event")
event_id = &"entered_terrain_test"
one_shot = true
actions = Array[ExtResource("5_action")]([SubResource("FlowAction_entered_save")])

[resource]
script = ExtResource("1_database")
events = Array[ExtResource("4_event")]([SubResource("FlowEvent_entered_terrain_test")])
levels = Array[ExtResource("2_level")]([SubResource("FlowLevelEntry_terrain_test")])
cutscenes = Array[ExtResource("3_cutscene")]([SubResource("FlowCutsceneEntry_intro")])
